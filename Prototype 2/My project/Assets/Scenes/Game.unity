  multiplierText: {fileID: 332943023}
  dialogueText: {fileID: 1967045612}
  dialogueList:
  - scoreTrigger: 1000
    message: '"[RADIO] Do you copy? We detected your crash."'
  - scoreTrigger: 3000
    message: "\"[RADIO] Stay calm. Head forward. We\u2019ll guide you out.\""
  - scoreTrigger: 6000
    message: '"[RADIO] Your signal is weak but stable. Keep moving."'
  - scoreTrigger: 9000
    message: "\"[RADIO] Don\u2019t stop. Rescue is ahead.\""
  - scoreTrigger: 12000
    message: '"[???] ...turn back..."'
  - scoreTrigger: 15000
    message: '"[RADIO] Ignore that. Signal interference is expected."'
  - scoreTrigger: 18000
    message: '"[???] y0u sh0uldnt b3 h3r3"'
  - scoreTrigger: 21000
    message: "\"[RADIO] Keep going forward. You\u2019re close.\""
  - scoreTrigger: 24000
    message: '"[???] th1s p4th 1s wr0ng"'
  - scoreTrigger: 28000
    message: '"[RADIO] Do NOT turn around. Repeat, do NOT turn around."'
  - scoreTrigger: 32000
    message: '"[RADIO] St--t-- s-gn-- l--s--g..."'
  - scoreTrigger: 35000
    message: '"[???] TURN B4CK N0W"'
  - scoreTrigger: 38000
    message: '"[RADIO] k--p g--ng f--w--d"'
  - scoreTrigger: 41000
    message: '"[???] th3 dUn3s d0nt l3t g0"'
  - scoreTrigger: 44000
    message: '"[RADIO] ---ERROR--- ---SIGNAL LOST---"'
  - scoreTrigger: 46000
    message: '"It''s right behind me."'
  - scoreTrigger: 48000
    message: '"[???] y0u c4nt 3sc4p3 by g01ng f0rw4rd"'
  - scoreTrigger: 35000
    message: '"I can''t outrun it."'
